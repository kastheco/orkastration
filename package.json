{
  "name": "orkastrator-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Orkastrator review policy for Pi Workflows and pi-subagents",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "orkastrator"
  ],
  "files": [
    "extensions/orkastrator-workflows",
    ".pi/workflows",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "pi-subagents": ">=0.59.0 <0.60.0"
  },
  "pi": {
    "extensions": [
      "./extensions/orkastrator-workflows/index.ts"
    ]
  },
  "scripts": {
    "test:extension": "node --experimental-strip-types --test extensions/orkastrator-workflows/tests/*.test.ts",
    "test:orkastrator": "npm run test:extension",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^22.20.1",
    "pi-subagents": "^0.59.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@osolmaz/pi-workflows": "^0.14.0"
  }
}
