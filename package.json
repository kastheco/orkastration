{
  "name": "orkastrator-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extensions for Orkastrator monitoring and lifecycle ownership",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "orkastrator"
  ],
  "files": [
    "extensions/orkastrator-monitors",
    "extensions/orkastrator",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/orkastrator-monitors/index.ts",
      "./extensions/orkastrator/index.ts"
    ]
  },
  "scripts": {
    "test:extension": "node --experimental-strip-types --test extensions/orkastrator-monitors/tests/*.test.ts extensions/orkastrator/tests/*.test.ts",
    "test:orkastrator": "node --experimental-strip-types --test extensions/orkastrator/tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^22.20.1",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
